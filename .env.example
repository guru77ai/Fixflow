# FixSoftRepair Pro - Environment Configuration

# ============================================
# Django Settings
# ============================================

# Secret key for Django (generate a new one for production)
# Use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug mode (set to False in production)
DJANGO_DEBUG=True

# Allowed hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Database Settings
# ============================================

# SQLite (default - no additional configuration needed)
# DATABASE_ENGINE=django.db.backends.sqlite3
# DATABASE_NAME=db.sqlite3

# PostgreSQL (uncomment and configure for PostgreSQL)
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=fixsoftrepair
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your-password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# ============================================
# Email Settings
# ============================================

# Email backend (options: smtp, console, file, in-memory)
# For development, use 'console' to print emails to console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Settings (for production)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@fixsoftrepair.com

# ============================================
# CORS Settings
# ============================================

# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Allow all origins in development (set to False in production)
CORS_ALLOW_ALL_ORIGINS=True

# ============================================
# JWT Authentication Settings
# ============================================

# Access token lifetime (in minutes)
JWT_ACCESS_TOKEN_LIFETIME=60

# Refresh token lifetime (in days)
JWT_REFRESH_TOKEN_LIFETIME=1

# ============================================
# Application Settings
# ============================================

# Default currency
DEFAULT_CURRENCY=DZD

# Default timezone
DEFAULT_TIMEZONE=Africa/Algiers

# Default language
DEFAULT_LANGUAGE=fr

# ============================================
# File Upload Settings
# ============================================

# Maximum file upload size (in bytes)
MAX_FILE_UPLOAD_SIZE=10485760  # 10MB

# Allowed file extensions (comma-separated)
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ============================================
# License Settings
# ============================================

# Path to the public key for license verification
LICENSE_PUBLIC_KEY_PATH=license/public_key.pem

# Enable license verification
LICENSE_VERIFICATION_ENABLED=True

# ============================================
# Logging Settings
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================
# Cache Settings
# ============================================

# Cache backend (options: locmem, file, redis)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Redis cache settings (uncomment for Redis)
# CACHE_BACKEND=django_redis.cache.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1
# CACHE_OPTIONS={"CLIENT_CLASS": "django_redis.client.DefaultClient"}

# ============================================
# Security Settings
# ============================================

# Session cookie settings
SESSION_COOKIE_AGE=86400  # 24 hours
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_SECURE=False  # Set to True in production with HTTPS
CSRF_COOKIE_HTTPONLY=True

# HTTPS settings
SECURE_SSL_REDIRECT=False  # Set to True in production with HTTPS
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
