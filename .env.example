# FixSoftRepair Pro - Environment Configuration
# ==============================================
# IMPORTANT: This file contains example values only.
# In production, use a proper secrets management system.
# Never commit this file with real secrets to version control.
# ==============================================

# ============================================
# Django Core Settings (REQUIRED)
# ============================================

# Secret key for Django - MUST be set in production
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-strong-secret-key-here-at-least-50-characters-long

# Debug mode - MUST be False in production
DJANGO_DEBUG=False

# Allowed hosts - comma-separated list of domain names
# In production: DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Database Settings (REQUIRED)
# ============================================

# For SQLite (development only - not recommended for production):
# DATABASE_ENGINE=django.db.backends.sqlite3
# DATABASE_NAME=/path/to/database.sqlite3

# For PostgreSQL (RECOMMENDED for production):
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=fixsoftrepair
DATABASE_USER=fixsoftrepair_user
DATABASE_PASSWORD=your-strong-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ============================================
# Security Settings (REQUIRED for Production)
# ============================================

# CSRF trusted origins - comma-separated
# Must include all domains that can make POST requests
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# CORS allowed origins - comma-separated
# Only set in production to specific trusted frontend domains
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# Email Settings
# ============================================

# Email backend (options: smtp, console, file, in-memory)
# For development, use 'console' to print emails to console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Settings (for production)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-email@yourdomain.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# JWT Authentication Settings
# ============================================

# Access token lifetime (in minutes)
JWT_ACCESS_TOKEN_LIFETIME=60

# Refresh token lifetime (in days)
JWT_REFRESH_TOKEN_LIFETIME=1

# ============================================
# Application Settings
# ============================================

# Default currency (DZD for Algeria, USD, EUR, etc.)
DEFAULT_CURRENCY=DZD

# Default timezone
DEFAULT_TIMEZONE=Africa/Algiers

# Default language (fr, ar, en)
DEFAULT_LANGUAGE=fr

# ============================================
# File Upload Settings
# ============================================

# Maximum file upload size (in bytes)
MAX_FILE_UPLOAD_SIZE=10485760  # 10MB

# Allowed file extensions (comma-separated)
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ============================================
# License Settings
# ============================================

# Path to the public key for license verification (relative to BASE_DIR)
LICENSE_PUBLIC_KEY_PATH=license/public_key.pem

# Enable license verification
LICENSE_VERIFICATION_ENABLED=True

# ============================================
# Logging Settings
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================
# Cache Settings
# ============================================

# Cache backend (options: locmem, file, redis)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Redis cache settings (uncomment for Redis)
# CACHE_BACKEND=django_redis.cache.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1
# CACHE_OPTIONS={"CLIENT_CLASS": "django_redis.client.DefaultClient"}

# ============================================
# Session Settings
# ============================================

# Session cookie settings
SESSION_COOKIE_AGE=86400  # 24 hours
SESSION_COOKIE_SECURE=True  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_SECURE=True  # Set to True in production with HTTPS
CSRF_COOKIE_HTTPONLY=True

# HTTPS settings
SECURE_SSL_REDIRECT=True  # Set to True in production with HTTPS
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
REFERRER_POLICY=same-origin
